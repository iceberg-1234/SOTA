# SOTA (소타) Open-Source Environment Configuration Template
# Copy this file to `.env` (which is git-ignored) or store secrets in macOS Keychain.
# NEVER commit real API keys to the repository.

# 1. Google Gemini Multimodal Vision API Key (Keychain service: SOTA_GEMINI_API_KEY)
GEMINI_API_KEY=

# 2. Seoul Metropolitan Subway Real-Time Arrival TOPIS API Key (Keychain service: SOTA_SEOUL_SUBWAY_API_KEY)
SEOUL_SUBWAY_API_KEY=

# 3. Seoul Metropolitan Bus Real-Time Arrival API Key (Keychain service: SOTA_SEOUL_BUS_API_KEY)
SEOUL_BUS_API_KEY=

# 4. SKT TMAP Open API Key — POI, Pedestrian Route, Public Transit (Keychain service: SOTA_TMAP_API_KEY)
TMAP_API_KEY=
